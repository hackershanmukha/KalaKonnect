# ==========================================
# KalaConnect AI - Environment Configuration
# ==========================================

# 1. Backend Configuration
# ------------------------------------------
PROJECT_NAME="KalaConnect AI"
SECRET_KEY="kalaconnect-secret-jwt-key-for-artisan-marketplace-auth-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default: Local SQLite for zero-setup instant local run
DATABASE_URL="sqlite:///./kalaconnect.db"
# Or connect directly to PostgreSQL / Supabase:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# AI Integrations
# Gemini API Key (Optional: system automatically includes rich cultural knowledge fallback if left blank)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Supabase (Optional storage/auth credentials)
SUPABASE_URL=""
SUPABASE_KEY=""

# 2. Frontend Configuration
# ------------------------------------------
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"

